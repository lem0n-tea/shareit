# Replace this with your own domain (e.g. yourname.duckdns.org or your own domain).
# Caddy auto-provisions a Let's Encrypt certificate for the hostname below.
your-domain.example.com {
	# Forward all requests to the app container over the internal Docker network.
	# "app" is the compose service name, which resolves to that container.
	reverse_proxy app:8000

	# Edge guard: reject any request whose body exceeds this, before it reaches the
	# app. This is the coarse infrastructure limit (DoS / early reject) -- it does NOT
	# replace the app's per-user quota + disk checks, it complements them.
	# Headroom above the app's 5 GB per-file cap so legit uploads pass; the app does
	# the precise size/quota checks and rejects cleanly.
	request_body {
		max_size 6GB
	}
}
