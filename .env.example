# Copy this file to .env and adjust. Never commit your real .env.
#
# Only SECRET_KEY has no default and must be set.
# Everything else has a sensible default; set it only to override.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ---- Required ----

# Secret used to sign JWT access and refresh tokens. Keep it secret.
# Rotating this invalidates every outstanding token.
SECRET_KEY=

# ---- Storage ----

# Directory where uploaded file bytes are stored on disk.
# Default: ./data/storage  (inside the Docker volume at /app/data/storage)
# STORAGE_DIR=./data/storage

# Total storage quota in bytes. Leave unset to use all available disk space.
# Example: 10737418240 for 10 GiB.
# STORAGE_LIMIT=

# Per-file upload cap in bytes. Default: 5 GiB (5368709120).
# The Caddy edge limit (6 GB by default) must stay above this.
# MAX_UPLOAD_SIZE=5368709120

# Directory for in-progress chunked upload parts (resumable uploads).
# Default: ./data/uploads
# PENDING_UPLOADS_DIR=./data/uploads

# ---- Chunked upload reaper ----

# Mark a chunked upload as stale after this many seconds of inactivity.
# The reaper then releases its reserved quota and deletes its parts. Default: 3600 (1 hour).
# UPLOAD_STALE_AFTER_SECONDS=3600

# How often the background reaper sweeps for stale uploads. Default: 43200 (12 hours).
# PERIODIC_REAP_INTERVAL_SECONDS=43200

# ---- Database ----

# SQLAlchemy connection URL. Default: SQLite file at ./data/shareit.db
# For Postgres, use e.g.: postgresql+psycopg://user:pass@host:5432/shareit
# DATABASE_URL=sqlite:///./data/shareit.db

# ---- Auth ----

# JWT signing algorithm. Default: HS256
# ALGORITHM=HS256

# Access token lifetime in minutes. Default: 15
# ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days. Default: 7
# REFRESH_TOKEN_EXPIRE_DAYS=7
